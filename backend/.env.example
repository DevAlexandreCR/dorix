OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL_KEY=balanced
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT=30

# Google Calendar OAuth (agendamiento). Ver sección "Integración Google
# Calendar" en el README raíz antes de habilitar en producción.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/oauth/google/callback
