VITE_APP_NAME=Dorix
VITE_API_BASE_URL=/api
VITE_BACKEND_HEALTH_URL=/api/health

# Meta Embedded Signup (add-meta-embedded-signup). Public values — they ship
# in the browser JS bundle regardless, same app id/config id as the
# backend's META_APP_ID / META_ES_CONFIG_ID (backend/.env.example).
# App id of Dorix's Meta app (Meta App Dashboard > App settings > Basic).
VITE_META_APP_ID=
# Embedded Signup configuration id (Meta App Dashboard > WhatsApp >
# Embedded Signup > Configurations). Assumed to work for both cloud_api and
# coexistence modes via `extras.featureType` — see the mapping comment in
# useMetaEmbeddedSignup.ts. If Meta requires two separate configs, this
# splits into VITE_META_ES_CONFIG_ID_CLOUD_API / _COEXISTENCE.
VITE_META_ES_CONFIG_ID=
